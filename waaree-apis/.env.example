# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=local                      # local | staging | production
CORS_ORIGINS=http://localhost:3000     # comma-separated, never *

# SQL Server
DB_SERVER=
DB_NAME=Waaree
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true       # set false in production with the RDS CA installed

# Running API: read/write data only
DB_APP_USER=waaree_app
DB_APP_PASSWORD=

# Alembic migrations only: can create/alter tables
DB_MIGRATOR_USER=waaree_migrator
DB_MIGRATOR_PASSWORD=

# Auth
AUTH_PROVIDER=local                    # later: Waaree's login provider
JWT_SECRET=                            # long random value: python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
COOKIE_SAMESITE=lax                    # "none" when web and API are on different domains (also needs HTTPS)

# Local only: password for test accounts created by `uv run python -m app.cli seed-dev`
DEV_SEED_PASSWORD=
