# Copy to .env.local. NEXT_PUBLIC_* values are baked in at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public URL of this site (share images / Open Graph). e.g. https://www.waaree.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Preview deployments only: 1 = ask search engines not to index the site
NEXT_PUBLIC_NOINDEX=
